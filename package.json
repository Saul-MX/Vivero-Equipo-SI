{
  "name": "vivero-el-encanto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:hostinger": "prisma generate && prisma migrate deploy && prisma db seed && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrar": "prisma migrate dev",
    "db:aplicar": "prisma migrate deploy",
    "db:semilla": "prisma db seed",
    "db:semilla:completar": "prisma db seed -- --forzar",
    "db:ver": "prisma studio",
    "pruebas": "playwright test",
    "pruebas:unidad": "playwright test -c playwright.unidad.config.ts",
    "pruebas:reporte": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.65.0",
    "mariadb": "^3.5.4",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
