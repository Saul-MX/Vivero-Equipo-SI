# Plantilla de variables de entorno.
# Copia este archivo como `.env` y llena los valores. El archivo `.env` NUNCA se sube a Git.

# Conexión a MySQL/MariaDB: mysql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
# `connectionLimit` limita las conexiones simultáneas (importante en hosting compartido).
DATABASE_URL="mysql://root@localhost:3306/vivero_encanto?connectionLimit=5"

# Base SOLO para las pruebas automáticas. Se borra y se vuelve a crear en cada corrida,
# por eso su nombre debe terminar en "_prueba" (las pruebas se niegan a tocar otra).
DATABASE_URL_PRUEBA="mysql://root@localhost:3306/vivero_encanto_prueba?connectionLimit=5"

# Carpeta donde se guardan las fotos y folletos subidos desde el panel.
# En tu computadora puede quedarse así («archivos» dentro del proyecto, ignorada por Git).
# En Hostinger debe estar FUERA de la carpeta de la app (cada despliegue la reemplaza), por ejemplo:
# UPLOADS_DIR="/home/USUARIO/archivos-vivero"
UPLOADS_DIR="archivos"

# Cuántos proxies hay delante de la app (el del hosting cuenta como 1). Sirve para saber la IP real de
# cada visita, que se usa en los límites de intentos. La IP se toma del final de X-Forwarded-For, donde
# la escribe el proxy; lo del principio lo puede inventar cualquiera. Si pones un CDN delante del
# hosting, súbelo a 2.
PROXIES_DE_CONFIANZA="1"

# Código para crear la PRIMERA cuenta del panel (mínimo 12 letras o números).
# Solo funciona mientras no exista ninguna cuenta; después, las invitaciones se crean en «Mi cuenta».
# Este valor de ejemplo NO funciona a propósito: cámbialo por uno tuyo.
CODIGO_INVITACION_INICIAL="CAMBIA-ESTE-CODIGO-2026"

# Dirección pública del sitio, sin «/» al final (en Hostinger: tu dominio, por ejemplo https://www.example.com).
# Se usa en los enlaces para compartir (Open Graph), en el mapa del sitio para buscadores y en el
# inicio de sesión (la vuelta de Google llega a SITIO_URL/api/auth/callback/google).
SITIO_URL="http://localhost:3000"

# Secreto con el que se firman las cookies de sesión y se cifran los tokens de Google.
# Obligatorio en producción: al menos 32 caracteres al azar. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si se cambia, todas las sesiones abiertas se cierran (hay que volver a entrar).
BETTER_AUTH_SECRET=""

# Entrar con Google (opcional: si se dejan vacías, el botón «Continuar con Google» no aparece).
# Se crean en https://console.cloud.google.com → «APIs y servicios» → «Credenciales» →
# «Crear credenciales» → «ID de cliente de OAuth» → tipo «Aplicación web», con:
#   - Orígenes autorizados de JavaScript: tu SITIO_URL
#     (en tu computadora: http://localhost:3000; en producción, tu dominio, por ejemplo https://www.example.com)
#   - URI de redireccionamiento autorizados: SITIO_URL + /api/auth/callback/google
#     (en tu computadora: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
